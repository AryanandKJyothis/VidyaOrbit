# ── Client-safe Supabase (already used by Vidya / Lovable) ─────────────────────
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Server-only (never expose — Lovable Secrets / Cloudflare Workers binding)
SUPABASE_SERVICE_ROLE_KEY=

# ── Razorpay one-time orders (Standard Checkout) ──────────────────────────────
# Dashboard → Developers → Keys (use rzp_test_… until RAZORPAY_ALLOW_LIVE=true)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Developers → Webhooks → this deployment's /api/webhooks/razorpay
# Subscribe to payment.captured and order.paid only.
RAZORPAY_WEBHOOK_SECRET=

# Billing kill switch. MUST stay unset/false on production until Preview is verified.
# Only the exact string "true" enables checkout, verify, and the webhook.
BILLING_ENABLED=false

# Required to use rzp_live_ keys. Exact string "true" only. Leave unset on Preview.
# RAZORPAY_ALLOW_LIVE=true

# Webhook endpoint you register in Razorpay (documented — not read by runtime):
#   https://<your-production-domain>/api/webhooks/razorpay
# Events: payment.captured, order.paid

# ── Contact information (public site, billing, mid-term tier-change CTAs) ─────
# Built-in defaults (used when these vars are unset):
#   phone    +91 7025063047
#   WhatsApp 917025063047  →  https://wa.me/917025063047
#   email    aryanandkjyothis4@gmail.com
# To OVERRIDE a value, uncomment and set it.
# To HIDE a channel, uncomment and set it to an empty string (e.g. VITE_CONTACT_PHONE=).
# Leave commented out to keep the built-in defaults.
# VITE_CONTACT_PHONE=+91 7025063047
# VITE_CONTACT_WHATSAPP=917025063047
# VITE_CONTACT_EMAIL=aryanandkjyothis4@gmail.com

# ── Search Console / Bing verification (optional, public meta tags) ───────────
# Leave unset until you have a token. When set, src/lib/seo.ts verificationMeta()
# injects them on every page via the root head. Do not commit live tokens.
#   Google Search Console → HTML tag → paste the content= value here
#   Bing Webmaster Tools  → HTML meta tag → paste the content= value here
# File verification alternative: drop the Google HTML file into /public/
# (e.g. public/googleXXXXXXXX.html) and deploy; no code change needed.
# VITE_GOOGLE_SITE_VERIFICATION=
# VITE_BING_SITE_VERIFICATION=

# ── Google sign-in (Supabase Auth → Providers → Google) ──────────────────────
# Wired on login and signup via supabase.auth.signInWithOAuth({ provider: "google" }).
# Only the exact string "true" shows the Continue with Google buttons.
# Leave unset until the Google provider is enabled on the Supabase project
# and the site URL / redirect URLs include this origin + /auth/callback
# (plus /dashboard and /join/* as fallbacks).
# VITE_GOOGLE_AUTH_ENABLED=true

# ── Parent WhatsApp (Phase A.1) ──────────────────────────────────────────────
# Tier 1 (shipped): staff send from the centre's own WhatsApp via wa.me.
# No Meta credentials required.
#
# Tier 2 (off by default, per-centre `wa_auto` flag): a worker may send queued
# rows through the WhatsApp Cloud API. Leave these unset until a centre has a
# verified number and approved templates. Never treat a missing config as sent.
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_BUSINESS_ACCOUNT_ID=
# WHATSAPP_API_VERSION=v21.0
# WHATSAPP_TEMPLATE_ABSENCE_NAME=
# WHATSAPP_TEMPLATE_ABSENCE_LANG=en
# WHATSAPP_TEMPLATE_FEE_PAID_NAME=
# WHATSAPP_TEMPLATE_FEE_PAID_LANG=en
#
# Cron for the Tier 2 stub: POST /api/messaging/process-auto
# Same CRON_SECRET as /api/keep-alive. Centres with wa_auto=false are skipped.
