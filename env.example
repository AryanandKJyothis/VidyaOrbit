# ── Client-safe Supabase (already used by Vidya / Lovable) ─────────────────────
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Server-only (never expose — Lovable Secrets / Cloudflare Workers binding)
SUPABASE_SERVICE_ROLE_KEY=

# ── Razorpay one-time orders (Standard Checkout) ──────────────────────────────
# Dashboard → Developers → Keys (use rzp_test_… until RAZORPAY_ALLOW_LIVE=true)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Developers → Webhooks → this deployment's /api/webhooks/razorpay
# Subscribe to payment.captured and order.paid only.
RAZORPAY_WEBHOOK_SECRET=

# Billing kill switch. MUST stay unset/false on production until Preview is verified.
# Only the exact string "true" enables checkout, verify, and the webhook.
BILLING_ENABLED=false

# Required to use rzp_live_ keys. Leave unset on Preview.
# RAZORPAY_ALLOW_LIVE=true

# Webhook endpoint you register in Razorpay (documented — not read by runtime):
#   https://<your-production-domain>/api/webhooks/razorpay
# Events: payment.captured, order.paid

# ── Contact information (public site, billing, mid-term tier-change CTAs) ─────
# Built-in defaults (used when these vars are unset):
#   phone    +91 7025063047
#   WhatsApp 917025063047  →  https://wa.me/917025063047
#   email    aryanandkjyothis4@gmail.com
# To OVERRIDE a value, uncomment and set it.
# To HIDE a channel, uncomment and set it to an empty string (e.g. VITE_CONTACT_PHONE=).
# Leave commented out to keep the built-in defaults.
# VITE_CONTACT_PHONE=+91 7025063047
# VITE_CONTACT_WHATSAPP=917025063047
# VITE_CONTACT_EMAIL=aryanandkjyothis4@gmail.com
