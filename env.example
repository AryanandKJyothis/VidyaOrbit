# ── Client-safe Supabase (already used by Vidya / Lovable) ─────────────────────
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Server-only (never expose — Lovable Secrets / Cloudflare Workers binding)
SUPABASE_SERVICE_ROLE_KEY=

# ── Razorpay (Subscriptions SaaS billing) ────────────────────────────────────
# Dashboard → Developers → Keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Developers → Webhooks → add endpoint → regenerate secret for this endpoint
RAZORPAY_WEBHOOK_SECRET=
# Razorpay plan ids (Plans → Billing → Subscription plans; copy plan_xxxxx IDs)
RAZORPAY_PLAN_STARTER=
RAZORPAY_PLAN_GROWTH=
RAZORPAY_PLAN_PRO=

# Webhook endpoint you register in Razorpay (documented — not read by runtime):
#   https://<your-production-domain>/api/webhooks/razorpay
# Prefer selecting these events: subscription.* (activated, charged, resumed, halted, paused, cancelled, completed)

# ── Contact information (public site, billing page) ────────────────────────────
# Built-in defaults (used when these vars are unset):
#   phone    +91 7025063047
#   WhatsApp 917025063047  →  https://wa.me/917025063047
#   email    aryanandkjyothis4@gmail.com
# To OVERRIDE a value, uncomment and set it.
# To HIDE a channel, uncomment and set it to an empty string (e.g. VITE_CONTACT_PHONE=).
# Leave commented out to keep the built-in defaults.
# VITE_CONTACT_PHONE=+91 7025063047
# VITE_CONTACT_WHATSAPP=917025063047
# VITE_CONTACT_EMAIL=aryanandkjyothis4@gmail.com
